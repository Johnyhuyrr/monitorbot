# Linux VPS install:
#   sudo cp zade-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zade-bot
#   sudo systemctl status zade-bot      (check it is running)
#   journalctl -u zade-bot -f           (watch live logs)

[Unit]
Description=Zade Meadows Discord Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/zade-bot
ExecStart=/home/botuser/zade-bot/venv/bin/python /home/botuser/zade-bot/bot.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
