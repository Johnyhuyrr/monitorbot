# Copy this file to  .env  and fill in your own values.
# NEVER commit .env, share it, screenshot it, or upload it anywhere.

# Required. Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Optional. Your server ID while testing: slash commands then appear
# instantly in that server instead of taking up to an hour globally.
SYNC_GUILD_ID=

# Optional. Localhost port used as a "one copy per machine" lock.
# Default 49221. Set to 0 to turn the port lock off; the data-folder lock
# (data/bot.lock) always stays on.
LOCK_PORT=49221

# Optional branding shown in the embeds.
BRAND_NAME=Zade Meadows

# Optional. Old jobs.json rows written before jobs carried a server ID are
# hidden from every server until they are assigned. If exactly one server
# has run /setup they are assigned to it automatically; otherwise put that
# server's ID here.
LEGACY_GUILD_ID=

# Optional. Where data/ and logs/ live. Relative paths are taken from the
# folder bot.py is in (never the working directory). Use this to point at a
# persistent volume on hosts such as Railway, Render or Fly.io.
ZM_DATA_DIR=
ZM_LOG_DIR=

# Leave false. Nothing in this bot reads message content; turning it on
# without ticking MESSAGE CONTENT INTENT in the Developer Portal stops the
# bot from logging in.
ENABLE_MESSAGE_CONTENT=false
